<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- URL, usuário e senha vêm de AppConfig (tela Configurações); ver Jpa.init(). -->
    <persistence-unit name="dignitas" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>br.com.dignitas.domain.Exam</class>
        <class>br.com.dignitas.domain.Subject</class>
        <class>br.com.dignitas.domain.ImportBatch</class>
        <class>br.com.dignitas.domain.BaseText</class>
        <class>br.com.dignitas.domain.Question</class>
        <class>br.com.dignitas.domain.Alternative</class>
        <class>br.com.dignitas.domain.Attempt</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <!-- O esquema é criado por resources/sql/schema.sql (SchemaInstaller), não pelo Hibernate. -->
            <property name="hibernate.hbm2ddl.auto" value="none"/>
            <property name="hibernate.hikari.maximumPoolSize" value="5"/>
            <property name="hibernate.hikari.connectionTimeout" value="5000"/>
            <property name="hibernate.jdbc.batch_size" value="50"/>
            <property name="hibernate.order_inserts" value="true"/>
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
